{
  "name": "cf-container-runners",
  "version": "0.1.0",
  "description": "Ephemeral GitHub Actions self-hosted runners on Cloudflare Containers: one container per job, $0 idle.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm typecheck && pnpm test",
    "deploy": "wrangler deploy",
    "dev": "wrangler dev"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261027.1",
    "typescript": "5.9.3",
    "vitest": "4.1.12",
    "wrangler": "4.154.0"
  }
}
